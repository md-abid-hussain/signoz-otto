# Copy to .env and fill in. .env is gitignored — never commit real keys.
SIGNOZ_URL=http://localhost:8080
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_API_KEY=            # SigNoz admin/write key; sent as the SIGNOZ-API-KEY header
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
OPENAI_API_KEY=            # needed only for the agent tail (translate-exotic / repair)

# optional live Grafana connect (migration source) — otherwise upload dashboard JSON directly
GRAFANA_URL=               # e.g. http://localhost:8081/grafana
GRAFANA_TOKEN=             # Bearer token, only if your Grafana requires auth

# self-instrumentation (Otto exports its own traces/metrics to SigNoz). Set OTTO_OTEL=1 to enable.
OTTO_OTEL=                  # 1 to turn on; empty = off (zero overhead)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # SigNoz OTLP/HTTP ingest
# LLM_COST_PER_1K_IN=        # optional $ per 1k input tokens → otto.llm.cost_usd
# LLM_COST_PER_1K_OUT=       # optional $ per 1k output tokens
