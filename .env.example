# Root env for docker-compose. Copy to `.env` and fill in the two secrets.
# .env is gitignored — never commit real keys.

# --- secrets (required) ---
SIGNOZ_API_KEY=            # SigNoz admin/write key (sent as the SIGNOZ-API-KEY header to the MCP server)
OPENAI_API_KEY=            # for the agent tail + AgentOtto + SLO reasoning

# --- endpoints (defaults reach a self-hosted SigNoz on the host) ---
SIGNOZ_URL=http://host.docker.internal:8080
SIGNOZ_MCP_URL=http://host.docker.internal:8000/mcp
GRAFANA_URL=http://host.docker.internal:8081/grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# --- options ---
OTTO_OTEL=1                # 1 = Otto self-instruments to SigNoz (recommended for the demo)
LLM_MODEL=gpt-5.6-terra
